# Copy to tools/release-contact.env, fill in, then: tools/release-contact.sh (dry run) / tools/release-contact.sh --apply
# Required
FEEDBACK_EMAIL=""        # the one public address: in-game Feedback (mailto + Copy report), privacy contact, Play listing contact
LEGAL_NAME=""            # who operates the game: your full name or the business name
FEEDBACK_RETENTION=""    # e.g. "up to 12 months after the issue is resolved"
EMAIL_PROVIDER=""        # who hosts that mailbox, e.g. "Google (Gmail)" or "Google Workspace"
EMAIL_PROVIDER_POLICY_URL=""   # e.g. https://policies.google.com/privacy
# Optional (defaults shown)
CONTACT_EMAIL=""         # default: FEEDBACK_EMAIL
EFFECTIVE_DATE=""        # default: the day you run --apply, e.g. "October 20, 2026"
YEAR=""                  # default: current year
DELETE_DAYS="30 days"    # how fast you confirm a feedback-deletion request
FUTURE_RELAY="a Cloudflare Worker or Supabase function"   # "coming later" section only
FUTURE_RETENTION=""      # "coming later" screenshot retention; default: FEEDBACK_RETENTION
DRAFT_BANNER="keep"      # "remove" drops the gold DRAFT banner once the text has been reviewed
